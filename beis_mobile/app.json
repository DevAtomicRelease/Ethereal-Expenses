{
  "expo": {
    "name": "BEIS", "slug": "beis-mobile", "version": "3.0.0", "orientation": "portrait",
    "scheme": "beis", "userInterfaceStyle": "automatic",
    "splash": { "image": "./assets/images/splash.png", "resizeMode": "contain", "backgroundColor": "#0F172A" },
    "ios": { "bundleIdentifier": "com.beis.app" },
    "android": { "package": "com.beis.app", "usesCleartextTraffic": true },
    "plugins": ["expo-router", "expo-secure-store", "expo-notifications"],
    "experiments": { "typedRoutes": true }
  }
}
